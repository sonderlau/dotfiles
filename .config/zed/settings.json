// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "openai_compatible": {
      "CodeAPI": {
        "api_url": "https://codeapi.icu",
        "available_models": [
          {
            "name": "gpt-5.5",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
        ],
      },
    },
  },
  "ssh_connections": [
    {
      "host": "SugonBareMetal",
      "args": [],
      "projects": [
        {
          "paths": ["/media"],
        },
        {
          "paths": ["/root/Downloads"],
        },
      ],
      "upload_binary_over_ssh": true,
    },
    {
      "host": "HDU-A800",
      "args": [],
      "projects": [],
    },
    {
      "host": "HDU-4090",
      "args": [],
      "projects": [
        {
          "paths": ["/media/hdu/intel_storage"],
        },
      ],
    },
  ],
  "cli_default_open_behavior": "existing_window",
  "vim_mode": true,
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "default_model": {
      "provider": "CodeAPI",
      "model": "gpt-5.5",
      "enable_thinking": false,
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Warm Burnout Light",
    "dark": "Warm Burnout Dark",
  },
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "Markdown": {
      "show_completions_on_input": false,
      "show_edit_predictions": false,
    },
  },
  "lsp": {
    "tinymist": {
      "settings": {
        "exportPdf": "onSave",
        "outputPath": "$root/$name",
      },
    },
    "pyrefly": {
      "binary": {
        "path": ".venv/bin/pyrefly",
        "arguments": ["lsp"],
      },
    },
  },
}
