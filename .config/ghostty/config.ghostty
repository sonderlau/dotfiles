# -------------------------------------------------- #
# Shell
# -------------------------------------------------- #
command = /opt/homebrew/bin/fish
shell-integration = detect
shell-integration-features = no-cursor,sudo,title,ssh-terminfo,ssh-env

# -------------------------------------------------- #
# Macos
# -------------------------------------------------- #
macos-titlebar-style = tabs
macos-titlebar-proxy-icon     = visible
macos-window-buttons          = hidden
macos-window-shadow           = true
macos-option-as-alt           = true
macos-auto-secure-input       = false
macos-secure-input-indication = true

# -------------------------------------------------- #
# Typography
# -------------------------------------------------- #
font-family = Maple Mono SC NF
font-size = 14
font-feature = -dlig
adjust-cell-height = 6

# -------------------------------------------------- #
# Custom
# -------------------------------------------------- #
theme = warm-burnout-dark
window-width = 150
window-height = 45
window-padding-x = 5
window-padding-y = 5
background-blur-radius = 20
background-opacity = 0.85
mouse-hide-while-typing = true
window-save-state = always
window-colorspace       = display-p3
unfocused-split-opacity = 0.8

# --- Performance ---
scrollback-limit = 25000000

# -------------------------------------------------- #
# Clipboard
# -------------------------------------------------- #
clipboard-read                 = allow
clipboard-write                = allow
clipboard-paste-protection     = true
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard


# --- Close behavior ---
confirm-close-surface = true


# Custom Shaders
custom-shader = ~/.config/ghostty/shaders/cursor_smear.glsl
